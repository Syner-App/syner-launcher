# Variables used by docker-compose.yml and docker-compose.prod.yml

# client-gateway: host port (the only service published to the host)
CLIENT_GATEWAY_PORT=3000

# Microservices: host (the Docker Compose service name) and gRPC port, reachable
# only inside the Docker network. The gateway uses the same values to reach them
PRODUCTS_MS_HOST=products-ms
PRODUCTS_MS_PORT=3001
ORDERS_MS_HOST=orders-ms
ORDERS_MS_PORT=3002
AUTH_MS_HOST=auth-ms
AUTH_MS_PORT=3003
FINANCE_MS_HOST=finance-ms
FINANCE_MS_PORT=3004

# PostgreSQL of products-ms (products-db). PRODUCTS_DB_USER owns the tables and runs the
# migrations (MIGRATE_DATABASE_URL); products-ms connects as PRODUCTS_DB_APP_USER, a role
# without superuser/BYPASSRLS created by postgres-init/app-role.sh on the first start, so
# the multitenancy RLS policies apply to it. Keep passwords URL-safe (they go into URLs)
PRODUCTS_DB_USER=postgres
PRODUCTS_DB_PASSWORD=change-me
PRODUCTS_DB_NAME=productsdb
PRODUCTS_DB_APP_USER=products_app
PRODUCTS_DB_APP_PASSWORD=change-me

# PostgreSQL of orders-ms (orders-db), same split as products-db
ORDERS_DB_USER=postgres
ORDERS_DB_PASSWORD=change-me
ORDERS_DB_NAME=ordersdb
ORDERS_DB_APP_USER=orders_app
ORDERS_DB_APP_PASSWORD=change-me

# PostgreSQL of finance-ms (finance-db), same split as products-db
FINANCE_DB_USER=postgres
FINANCE_DB_PASSWORD=change-me
FINANCE_DB_NAME=financedb
FINANCE_DB_APP_USER=finance_app
FINANCE_DB_APP_PASSWORD=change-me

# MongoDB of auth-ms (auth-db), single-node replica set rs0
AUTH_DATABASE_URL=mongodb://auth-db:27017/authdb?replicaSet=rs0&directConnection=true

# RabbitMQ; the guest user is declared in rabbitmq/definitions.json
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Secret used by auth-ms to sign the JWTs
JWT_SECRET=change-me

# Platform superadmin: creates organizations and their members. auth-ms creates it on
# startup if no user has SUPERADMIN_EMAIL (an existing user is never overwritten)
SUPERADMIN_NAME=Superadmin
SUPERADMIN_EMAIL=superadmin@syner.com
SUPERADMIN_PASSWORD=change-me

# finance-ms: day (and so accounting period) of a sale or expense registered without fecha
BUSINESS_TIMEZONE=America/Bogota
