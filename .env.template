# Variables used by docker-compose.yml and docker-compose.prod.yml

# client-gateway: host port (the only service published to the host)
CLIENT_GATEWAY_PORT=3000

# Microservices: host (the Docker Compose service name) and gRPC port, reachable
# only inside the Docker network. The gateway uses the same values to reach them
PRODUCTS_MS_HOST=products-ms
PRODUCTS_MS_PORT=3001
ORDERS_MS_HOST=orders-ms
ORDERS_MS_PORT=3002
AUTH_MS_HOST=auth-ms
AUTH_MS_PORT=3003

# PostgreSQL of products-ms (products-db); DATABASE_URL is built from these values
PRODUCTS_DB_USER=postgres
PRODUCTS_DB_PASSWORD=change-me
PRODUCTS_DB_NAME=productsdb

# PostgreSQL of orders-ms (orders-db); DATABASE_URL is built from these values
ORDERS_DB_USER=postgres
ORDERS_DB_PASSWORD=change-me
ORDERS_DB_NAME=ordersdb

# MongoDB of auth-ms (auth-db), single-node replica set rs0
AUTH_DATABASE_URL=mongodb://auth-db:27017/authdb?replicaSet=rs0&directConnection=true

# RabbitMQ; the guest user is declared in rabbitmq/definitions.json
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672

# Secret used by auth-ms to sign the JWTs
JWT_SECRET=change-me

# Initial owner of the system, created by auth-ms on startup if no user has
# OWNER_EMAIL (an existing user is never overwritten)
OWNER_NAME=Owner
OWNER_EMAIL=owner@syner.com
OWNER_PASSWORD=change-me
